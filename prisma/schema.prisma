generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model dangky_phantichsuco {
  masuco           Int       @id(map: "PK_dangky_phantichsuco")
  ngay             DateTime? @db.DateTime
  mota             String?   @db.NVarChar(500)
  kythuat          String?   @db.NVarChar(50)
  nhiemkhuan       String?   @db.NVarChar(50)
  thuoc            String?   @db.NVarChar(50)
  mau              String?   @db.NVarChar(50)
  thietbiyte       String?   @db.NVarChar(50)
  hanhvi           String?   @db.NVarChar(50)
  tainan           String?   @db.NVarChar(50)
  hatang           String?   @db.NVarChar(50)
  nguonluc         String?   @db.NVarChar(50)
  tailieu          String?   @db.NVarChar(50)
  ptkhac           String?   @db.NVarChar(50)
  machuyenvien     Int?
  ylenh            String?   @db.NVarChar(500)
  nnnnhanvien      String?   @db.NVarChar(50)
  nnnnguoibenh     String?   @db.NVarChar(50)
  nnnmoitruong     String?   @db.NVarChar(50)
  nnntochuc        String?   @db.NVarChar(50)
  nnnbenngoai      String?   @db.NVarChar(50)
  nnnkhac          String?   @db.NVarChar(50)
  khacphucsuco     String?   @db.NVarChar(500)
  dexuat           String?   @db.NVarChar(500)
  chuyengiadanhgia String?   @db.NVarChar(500)
  cgthaoluan       String?   @db.NVarChar(50)
  phuhop           String?   @db.NVarChar(50)
  khuyencao        String?   @db.NVarChar(500)
  tt_NC0           Boolean?
  tt_NC1           String?   @db.NVarChar(50)
  tt_NC2           String?   @db.NVarChar(50)
  tt_NC3           String?   @db.NVarChar(50)
  tttochuc         String?   @db.NVarChar(50)
  malanhdao        Int?
  duyet            Boolean?

  // Relation 1-1 → dangky_sucoykhoa
  sucoykhoa dangky_sucoykhoa @relation(fields: [masuco], references: [masuco])
}

model dangky_sucoykhoa {
  masuco               Int       @id(map: "PK_dangky_sucoykhoa")
  sosuco               String?   @db.NVarChar(15)
  ngay                 DateTime? @db.SmallDateTime
  mahinhthuc           Int?
  makcb                String?   @db.NVarChar(15)
  hoten                String?   @db.NVarChar(250)
  maphong              Int?
  madoituongsc         Int?
  ngaysinh             DateTime? @db.SmallDateTime
  sobenhan             String?   @db.NVarChar(50)
  maphai               Int?
  madonnguyen          Int?
  tensuco              String?   @db.NVarChar(250)
  ngaysuco             DateTime? @db.SmallDateTime
  maphongnoi           Int?
  vitricuthe           String?   @db.NVarChar(250)
  mota                 String?   @db.NVarChar(Max)
  giaiphapdexuat       String?   @db.NVarChar(500)
  xulybandau           String?   @db.NVarChar(500)
  thongbaobacsy        String?   @db.NVarChar(10)
  thongbaonguoinha     String?   @db.NVarChar(10)
  ghinhan              String?   @db.NVarChar(10)
  thongbaonguoibenh    String?   @db.NVarChar(10)
  phanloaibandau       String?   @db.NVarChar(10)
  danhgiabandau        String?   @db.NVarChar(10)
  manguoibaocao        Int?
  hotennguoibaocao     String?   @db.NVarChar(150)
  dienthoainguoibaocao String?   @db.NVarChar(150)
  emailnguoibaocao     String?   @db.NVarChar(150)
  chungkien1           String?   @db.NVarChar(150)
  chungkien2           String?   @db.NVarChar(150)
  nguoibckhac          String?   @db.NVarChar(Max)
  txtmakkbaocao        Int?
  makkbaocao           Int?
  nguyennhangoc        String?   @db.NVarChar(Max)
  giaiphaptranhlaplai  String?   @db.NVarChar(Max)
  maloaiscyk           Int?

  // Relation 1-1 ngược lại từ dangky_phantichsuco
  phantichsuco dangky_phantichsuco?
}

model dmhanhvi_scyk {
  mahanhvi  Int     @id(map: "PK_dmhanhvi_scyk")
  tenhanhvi String? @db.NVarChar(50)
}

model dmhatang_scyk {
  mahatang  Int     @id(map: "PK_dmhatang_scyk")
  tenhatang String? @db.NVarChar(50)
}

model dmkythuat_scyk {
  makythuat  Int     @id(map: "PK_dmkythuat_scyk")
  tenkythuat String? @db.NVarChar(200)
}

model dmloaisuco {
  maloaiscyk  Int      @id(map: "PK_dmloaisuco")
  tenloaiscyk String?  @db.NVarChar(Max)
  sapxep      Int?
  ksd         Boolean?
}

model dmmau_scyk {
  mamau  Int     @id(map: "PK_dmmau_scyk")
  tenmau String? @db.NVarChar(50)
}

model dmmoitruong_scyk {
  mamoitruong  Int     @id(map: "PK_dmmoitruong_scyk")
  tenmoitruong String? @db.NVarChar(200)
}

model dmnguoibenh_scyk {
  manguoibenh  Int     @id(map: "PK_dmnguoibenh_scyk")
  tennguoibenh String? @db.NVarChar(50)
}

model dmnguonluc_scyk {
  manguonluc  Int     @id(map: "PK_dmnguonluc_scyk")
  tennguonluc String? @db.NVarChar(200)
}

model dmnhanvien_scyk {
  manhanvien  Int     @id(map: "PK_dmnhanvien_scyk")
  tennhanvien String? @db.NVarChar(200)
}

model dmnhiemkhuan_scyk {
  manhiemkhuan  Int     @id(map: "PK_dmnhiemkhuan_scyk")
  tennhiemkhuan String? @db.NVarChar(50)
}

model dmtailieu_scyk {
  matailieu  Int     @id(map: "PK_dmtailieu_scyk")
  tentailieu String? @db.NVarChar(50)
}

model dmtainan_scyk {
  matainan  Int     @id(map: "PK_dmtainan_scyk")
  tentainan String? @db.NVarChar(50)
}

model dmtensucoyk {
  idscyk    Int      @id(map: "PK_dmtensucoyk")
  tensucoyk String?  @db.NVarChar(500)
  ksd       Boolean?
  sapxep    Int?
}

model dmthietbiyte_scyk {
  mathietbiyte  Int     @id(map: "PK_dmthietbiyte_scyk")
  tenthietbiyte String? @db.NVarChar(50)
}

model dmthuoc_scyk {
  mathuoc  Int     @id(map: "PK_dmthuoc_scyk")
  tenthuoc String? @db.NVarChar(50)
}

model dmtochuc_scyk {
  matochuc  Int     @id(map: "PK_dmtochuc_scyk")
  tentochuc String? @db.NVarChar(200)
}

model dmvitrisuco {
  mavt  Int     @id(map: "PK_dmvitrisuco")
  tenvt String? @db.NVarChar(250)
}

model dmyeutobenngoai_scyk {
  mayeutobenngoai  Int     @id(map: "PK_dmyeutobenngoai_scyk")
  tenyeutobenngoai String? @db.NVarChar(50)
}

model users {
  id            String  @id(map: "PK_users") @db.NVarChar(10)
  hovaten       String  @db.NVarChar(500)
  sdt           String  @db.NChar(10)
  email         String  @db.NVarChar(500)
  khoahoacphong String  @db.NVarChar(500)
  username      String  @db.NVarChar(50)
  password      String  @db.NVarChar(50)
  quyen         String  @db.NVarChar(50)
  active        Boolean
}
